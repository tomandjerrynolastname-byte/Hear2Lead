# Hear2Lead Environment Variables Configuration

# ----------------------------------------------------
# Option A: Supabase Connection (Recommended for Vercel)
# ----------------------------------------------------
# Copy the Connection String from Supabase: Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alternatively, set individual credentials:
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASS=your-db-password

# ----------------------------------------------------
# Option B: Local XAMPP MySQL Configuration (Default)
# ----------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=student_leadership_db
# DB_USER=root
# DB_PASS=
